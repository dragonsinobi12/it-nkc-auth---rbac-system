// prisma/schema.prisma
// โค้ดตามโจทย์ https://github.com/it-nkc/auth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // หรือ "postgresql" สำหรับ production
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
