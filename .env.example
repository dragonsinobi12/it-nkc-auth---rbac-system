# =================================================================
# Environment Variables Configuration
# ตามโจทย์ https://github.com/it-nkc/auth
# =================================================================

# 1. NextAuth / Auth.js Secret Key
# สร้างได้ด้วยคำสั่ง: npx auth secret
AUTH_SECRET="your-super-secret-auth-key-change-this"

# 2. GitHub OAuth App Credentials
# รับค่าได้จากการสร้าง OAuth App ที่ GitHub:
# Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your_github_client_id_here"
AUTH_GITHUB_SECRET="your_github_client_secret_here"

# 3. Prisma Database Connection URL
# รองรับทั้ง SQLite (สำหรับ Development แบบรวดเร็วไม่ต้องลง DB เพิ่ม) หรือ PostgreSQL / MySQL
DATABASE_URL="file:./dev.db"

# 4. Base Application URL
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
